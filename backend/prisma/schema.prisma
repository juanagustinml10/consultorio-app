// Esquema de la base de datos del consultorio (Etapa 2).
// DATABASE_URL: conexión normal (pooler de Supabase o PostgreSQL local).
// DIRECT_URL: conexión directa a Supabase, usada por Prisma CLI en
//             `migrate deploy` / `migrate dev` / `db push` (requiere
//             transacciones dedicadas que el pooler en modo transacción no da).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ===== Enumeraciones =====

// Roles de acceso al sistema.
enum Rol {
  MEDICO
  SECRETARIA
}

// Sexo del paciente (opcional, autoidentificado si corresponde).
enum Sexo {
  MASCULINO
  FEMENINO
  OTRO
}

// Estados del turno dentro del flujo de atención.
enum EstadoTurno {
  PROGRAMADO
  CONFIRMADO
  EN_ESPERA
  EN_ATENCION
  ATENDIDO
  AUSENTE
  CANCELADO
}

// Métodos de pago admitidos.
enum MetodoPago {
  EFECTIVO
  TRANSFERENCIA
  OBRA_SOCIAL
  PARTICULAR
}

// Estado del pago / cobertura de la factura.
enum EstadoPago {
  PENDIENTE
  PAGADO
  CUBIERTO
  ANULADO
}

// Estado de vigencia del aviso/noticia del sitio público.
enum EstadoAviso {
  VIGENTE
  VENCIDO
}

// Tipo de acción registrada en la auditoría.
enum AccionAuditoria {
  CREACION
  ACTUALIZACION
  LOGIN
  LOGOUT
  EXPORTACION
}

// ===== Modelos =====

// Usuario del sistema (médico o secretaria).
model Usuario {
  id             String   @id @default(cuid())
  email          String   @unique
  contrasenaHash String
  nombre         String
  apellido       String
  rol            Rol
  activo         Boolean  @default(true)
  creadoEn       DateTime @default(now())
  actualizadoEn  DateTime @updatedAt

  sesiones            Session[]
  turnosCreados       Turno[]                  @relation("TurnoRegistradoPor")
  turnosCancelados    Turno[]                  @relation("TurnoCanceladoPor")
  consultas           ConsultaClinica[]
  versionesCapturadas ConsultaClinicaVersion[] @relation("VersionCapturadaPor")
  auditorias          AuditLog[]
  pagos               Pago[]                   @relation("PagoRegistradoPor")

  @@map("usuarios")
}

// Sesión del servidor almacenada en PostgreSQL.
// La cookie contiene un token aleatorio; la tabla guarda solo su hash SHA-256.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  usuarioId String
  ip        String?
  userAgent String?
  creadoEn  DateTime @default(now())
  expiraEn  DateTime

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([expiraEn])
  @@map("sesiones")
}

// Estado compartido del límite de intentos de inicio de sesión.
// keyHash es un HMAC del identificador (IP + email normalizado), nunca el valor original.
model LoginRateLimit {
  keyHash         String   @id @db.VarChar(64)
  windowStartedAt DateTime @db.Timestamptz(6)
  failures        Int      @default(0)
  activeAttempts  Int      @default(0)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  @@index([windowStartedAt])
  @@map("intentos_limite_login")
}

// Obra social o prepaga (administrable). Se relaciona con los pacientes.
model ObraSocial {
  id            String   @id @default(cuid())
  nombre        String   @unique
  activo        Boolean  @default(true)
  notas         String?
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  pacientes Paciente[]

  @@map("obras_sociales")
}

// Paciente del consultorio.
model Paciente {
  id              String    @id @default(cuid())
  nombre          String
  apellido        String
  dni             String    @unique
  fechaNacimiento DateTime?
  sexo            Sexo?
  telefono        String?
  email           String?
  direccion       String?
  obraSocialId    String?
  numeroAfiliado  String?
  notas           String? // Observaciones administrativas
  creadoEn        DateTime  @default(now())
  actualizadoEn   DateTime  @updatedAt

  obraSocial      ObraSocial?      @relation(fields: [obraSocialId], references: [id])
  turnos          Turno[]
  historiaClinica HistoriaClinica?
  pagos           Pago[]

  @@index([nombre, apellido])
  @@map("pacientes")
}

// Historia clínica: contiene 1 ConsultaClinica por cada visita (registros independientes).
model HistoriaClinica {
  id                     String   @id @default(cuid())
  pacienteId             String   @unique
  antecedentesPersonales String?
  antecedentesFamiliares String?
  alergias               String?
  medicacionHabitual     String?
  observaciones          String?
  version                Int      @default(1) // Se incrementa con cada modificación de antecedentes/encabezado
  creadoEn               DateTime @default(now())
  actualizadoEn          DateTime @updatedAt

  paciente  Paciente          @relation(fields: [pacienteId], references: [id])
  consultas ConsultaClinica[]

  @@map("historias_clinicas")
}

// Consulta clínica (CADA consulta es un registro independiente; nunca se sobrescribe el historial).
model ConsultaClinica {
  id              String    @id @default(cuid())
  historiaId      String
  turnoId         String?   @unique
  fecha           DateTime  @default(now()) // Fecha y hora de la consulta
  motivoConsulta  String?
  sintomas        String?
  evaluacion      String?
  diagnostico     String?
  tratamiento     String?
  indicaciones    String?
  proximoControl  DateTime?
  registradoPorId String
  version         Int       @default(1)
  esCorreccion    Boolean   @default(false) // Identifica modificaciones como correcciones
  creadoEn        DateTime  @default(now())
  actualizadoEn   DateTime  @updatedAt

  historia      HistoriaClinica          @relation(fields: [historiaId], references: [id])
  turno         Turno?                   @relation(fields: [turnoId], references: [id], onDelete: SetNull)
  registradoPor Usuario                  @relation(fields: [registradoPorId], references: [id])
  versiones     ConsultaClinicaVersion[]
  pagos         Pago[]

  @@index([historiaId, fecha])
  @@map("consultas_clinicas")
}

// Versiones anteriores de cada consulta clínica (conservación del historial de cambios).
model ConsultaClinicaVersion {
  id             String   @id @default(cuid())
  consultaId     String
  version        Int // Número de la versión de la consulta al momento de capturar el snapshot
  datos          Json // Snapshot completo de la consulta previa a la modificación
  capturadoPorId String?
  capturadoEn    DateTime @default(now())

  consulta     ConsultaClinica @relation(fields: [consultaId], references: [id], onDelete: Cascade)
  capturadoPor Usuario?        @relation("VersionCapturadaPor", fields: [capturadoPorId], references: [id])

  @@unique([consultaId, version])
  @@map("consultas_clinicas_versiones")
}

// Inscripción diaria / turno de consulta.
// El número de atención se asigna por fecha y nunca se reutiliza.
model Turno {
  id                 String      @id @default(cuid())
  pacienteId         String
  fechaAtencion      DateTime    @db.Date
  fechaHora          DateTime // Dato histórico del modelo anterior (inicio del día)
  horaFin            DateTime? // Momento de finalización de la atención
  duracionMin        Int         @default(30)
  motivo             String?
  estado             EstadoTurno @default(EN_ESPERA)
  horaLlegada        DateTime? // Dato histórico del modelo anterior (no se muestra)
  fechaOrdenAtencion DateTime?   @db.Date
  numeroOrdenDia     Int?
  notas              String? // Observaciones administrativas
  motivoCancelacion  String?
  canceladoEn        DateTime?
  canceladoPorId     String?
  registradoPorId    String?
  creadoEn           DateTime    @default(now())
  actualizadoEn      DateTime    @updatedAt

  paciente        Paciente         @relation(fields: [pacienteId], references: [id])
  registradoPor   Usuario?         @relation("TurnoRegistradoPor", fields: [registradoPorId], references: [id])
  canceladoPor    Usuario?         @relation("TurnoCanceladoPor", fields: [canceladoPorId], references: [id])
  pagos           Pago[]
  consultaClinica ConsultaClinica?

  @@unique([fechaOrdenAtencion, numeroOrdenDia])
  @@index([fechaAtencion])
  @@index([fechaAtencion, estado])
  @@index([pacienteId])
  @@index([estado])
  @@map("turnos")
}

// Contador atómico que asigna posiciones diarias sin reutilizar números.
model OrdenAtencionDiaria {
  fecha        DateTime @id @db.Date
  ultimoNumero Int

  @@map("ordenes_atencion_diarias")
}

// Pago o cobertura de un turno/consulta (etapa futura: facturación completa).
model Pago {
  id                String     @id @default(cuid())
  pacienteId        String
  turnoId           String?
  consultaClinicaId String?
  importe           Decimal    @db.Decimal(10, 2)
  metodo            MetodoPago
  estado            EstadoPago @default(PENDIENTE)
  fecha             DateTime   @default(now())
  observaciones     String?
  registradoPorId   String?
  creadoEn          DateTime   @default(now())
  actualizadoEn     DateTime   @updatedAt

  paciente        Paciente         @relation(fields: [pacienteId], references: [id])
  turno           Turno?           @relation(fields: [turnoId], references: [id])
  consultaClinica ConsultaClinica? @relation(fields: [consultaClinicaId], references: [id])
  registradoPor   Usuario?         @relation("PagoRegistradoPor", fields: [registradoPorId], references: [id])

  @@index([pacienteId])
  @@index([turnoId])
  @@map("pagos")
}

// Auditoría: registra quién creó/modificó/corrigió información y cuándo.
// NO guardar contraseñas, tokens ni secretos en los snapshots JSON.
model AuditLog {
  id         String          @id @default(cuid())
  usuarioId  String?
  accion     AccionAuditoria
  entidad    String // p. ej. "Paciente", "Turno", "ConsultaClinica"
  registroId String
  previo     Json? // Información anterior (cuando corresponde)
  nuevo      Json? // Información nueva (cuando corresponde)
  ip         String?
  creadoEn   DateTime        @default(now())

  usuario Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([entidad, registroId])
  @@index([usuarioId])
  @@index([creadoEn])
  @@map("auditoria")
}

// Avisos visibles en la página pública (vacaciones, cambio de horario, novedades).
model Aviso {
  id       String      @id @default(cuid())
  titulo   String
  mensaje  String
  desde    DateTime
  hasta    DateTime
  estado   EstadoAviso @default(VIGENTE)
  creadoEn DateTime    @default(now())

  @@map("avisos")
}

// Datos editables del sitio público (perfil del médico, servicios, FAQ, contacto).
// Etapa futura: CRUD desde el panel.
model ContenidoSitio {
  id    String @id @default(cuid())
  clave String @unique // p.ej. "perfil", "horarios", "obras-sociales", "faq"
  valor Json

  @@map("contenido_sitio")
}
