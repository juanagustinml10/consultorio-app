# Conexión a la base de datos (etapa 2: PostgreSQL local, luego Neon)
# Formato local:  postgresql://<usuario>:<contrasena>@localhost:5432/consultorio
# Formato Neon:   postgresql://<usuario>:<contrasena>@ep-xxxx.neon.tech/consultorio?sslmode=require
DATABASE_URL="postgresql://usuario:contrasena@localhost:5432/consultorio"

# Puerto de la API
PORT=3001
