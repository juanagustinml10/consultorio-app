# ==== Desarrollo local con Node.js (`npm run dev`) ====

# Base de datos PostgreSQL local. En Supabase, usar Transaction pooler (puerto 6543)
# para el runtime serverless; agregar pgbouncer=true y connection_limit=1.
# El adaptador @prisma/adapter-pg descarta esos parámetros antes de conectar.
DATABASE_URL="postgresql://postgres@localhost:5432/consultorio_db?schema=public"

# Conexión directa (misma base local). Requerida por `directUrl` en schema.prisma.
# En Supabase: usar endpoint directo o Session pooler (puerto 5432), nunca el
# Transaction pooler para migraciones. No se usa para consultas del backend.
DIRECT_URL="postgresql://postgres@localhost:5432/consultorio_db?schema=public"

# Opcional pero recomendado: secreto aleatorio estable de 32+ bytes para HMAC del
# identificador del rate limit. Si se omite, se deriva de DATABASE_URL.
# LOGIN_RATE_LIMIT_SECRET=""

# Puerto del servidor API (sólo desarrollo local con Node.js)
PORT=3001

# Origen del frontend para CORS (cookies HttpOnly)
CORS_ORIGIN="http://localhost:5173"

# Duración de la sesión en horas
SESION_HORAS=8

# lax (por defecto) | strict | none. Usar "none" sólo si el frontend y la API
# están en dominios distintos; el navegador exige Secure (HTTPS).
# COOKIE_SAMESITE=lax

# Entorno (development | production)
NODE_ENV=development

# ==== Cloudflare Workers (`npm run dev:worker` / `npm run deploy:worker`) ====
#
# En Cloudflare NO se usa este archivo. Configurar como secretos/variables del
# Worker (wrangler secret put / wrangler.jsonc) o, para pruebas locales,
# en backend/.dev.vars (copiar desde .dev.vars.example).
#
# Runtime:
#   - HYPERDRIVE (binding, recomendado) o DATABASE_URL (secreto)
#   - CORS_ORIGIN
#   - LOGIN_RATE_LIMIT_SECRET
#   - SESION_HORAS
#   - COOKIE_SAMESITE
#   - NODE_ENV=production
# CLI de Prisma (no se ejecuta dentro del Worker):
#   - DIRECT_URL y DATABASE_URL en este .env
