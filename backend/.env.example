# Base de datos PostgreSQL local. En Supabase, usar Transaction pooler (puerto 6543)
# para el runtime serverless; agregar pgbouncer=true y connection_limit=1.
DATABASE_URL="postgresql://postgres@localhost:5432/consultorio_db?schema=public"

# Conexión directa (misma base local). Requerida por `directUrl` en schema.prisma.
# En Supabase: usar endpoint directo o Session pooler (puerto 5432), nunca el
# Transaction pooler para migraciones. No se usa para consultas del backend.
DIRECT_URL="postgresql://postgres@localhost:5432/consultorio_db?schema=public"

# Opcional pero recomendado: secreto aleatorio estable de 32+ bytes para HMAC del
# identificador del rate limit. Si se omite, se deriva de DATABASE_URL.
# LOGIN_RATE_LIMIT_SECRET=""

# Puerto del servidor API
PORT=3001

# Origen del frontend para CORS (cookies HttpOnly)
CORS_ORIGIN="http://localhost:5173"

# Duración de la sesión en horas
SESION_HORAS=8

# Entorno (development | production)
NODE_ENV=development
